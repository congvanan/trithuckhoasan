# Frontend
frontend/node_modules/
frontend/.next/
frontend/.env.local
frontend/.env*.local

# Backend
backend/aspnet-core/src/*/bin/
backend/aspnet-core/src/*/obj/
backend/aspnet-core/*.user
backend/aspnet-core/.vs/
backend/tools/*/bin/
backend/tools/*/obj/

# Sensitive config files (contain connection strings, secrets)
backend/**/appsettings.secrets.json
backend/**/appsettings.json
# Keep only Development/template appsettings
!backend/**/appsettings.Development.json

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.suo
*.user

# Build cache / temp
.tmp/

# DB backups (created by maintenance scripts)
backups/

# Backend logs (cả Logs/ ở root và trong từng project)
backend/aspnet-core/Logs/
backend/aspnet-core/**/Logs/
